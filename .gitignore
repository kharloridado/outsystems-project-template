node_modules/
dist/
*.log
.DS_Store

# Board-driven mode: each routine run builds in a throwaway git worktree, and takes a
# mkdir-based lock so a cron run and an interactive session cannot race (LESSONS.md §4.3).
.board-worktrees/
loop/.board-*.lock

# Session-approved, machine-specific permissions — never share these.
.claude/settings.local.json

# Generated by `npm run build:osui` from the pinned vendor/outsystems-ui submodule.
# Derived output, like dist/ — committing it duplicates state that can silently drift
# from the submodule pin it was built from.
#
# ONLY the outsystems-ui subdirectory. Its siblings under preview/vendor/ (flatpickr,
# fontawesome, virtual-select, …) are hand-vendored PROVIDER CSS and MUST stay
# committed — preview/index.html links them so the harness renders what ODC renders.
# Ignoring all of preview/vendor/ would strip them from a fresh clone, the preview
# would 404 on them, and the fidelity gate would invalidate every viewport.
preview/vendor/outsystems-ui/

# Licensed vendor assets (icon-font metadata, vector artwork). See vendor/LICENSING.md.
# These are paid assets: do not commit or redistribute them. One such metadata file
# also exceeds GitHub's 100MB file limit.
vendor/**/metadata/
