node_modules/
dist/
*.log
.DS_Store

# Board-driven mode: each routine run builds in a throwaway git worktree, and takes a
# mkdir-based lock so a cron run and an interactive session cannot race (loop/LESSONS.md §2.3).
.board-worktrees/
loop/.board-*.lock

# Session-approved, machine-specific permissions — never share these.
.claude/settings.local.json

# Generated. review/ holds each build's specimen page and review Artifact, plus the compiled
# OutSystems UI base from `npm run build:osui` — all derived from committed sources.
/review/

# Licensed vendor assets (icon-font metadata, vector artwork). See vendor/LICENSING.md.
# These are paid assets: do not commit or redistribute them. One such metadata file
# also exceeds GitHub's 100MB file limit.
vendor/**/metadata/
